# Built JS bundles under assets/js/ are tracked so that installs from
# trunk / GitHub work without running `npm run build`. Regenerate with
# `npm run build` and commit the updated artifacts alongside source.

.DS_Store

# Default output file of macOS/BSD `script(1)` — a terminal session
# recorder. Easy to commit by accident with `git add .`.
/typescript

# Playwright CLI
.playwright-cli/

# Phpactor's per-project config — Zed's PHP language server re-generates
# this on demand from sensible defaults, so tracking it just creates churn.
/.phpactor.json
